# ==========================================================
# ShopEase Environment Configuration Template
# ==========================================================
# Copy this file to .env for local development or input these
# key-value pairs into your cloud hosting dashboard (Render, Railway, etc.)
# ==========================================================

# Port for the Node.js / Express server (cloud hosts like Render/Railway set this automatically)
PORT=3000

# Node environment mode: set to 'production' on cloud hosts
NODE_ENV=production

# MongoDB Connection String:
# - Local development: mongodb://127.0.0.1:27017/shopease
# - Cloud / MongoDB Atlas: mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/shopease?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/shopease?retryWrites=true&w=majority

# Secret key for signing and verifying JSON Web Tokens (use a strong random string)
JWT_SECRET=replace_with_a_long_random_secure_secret_key_minimum_32_characters

# CORS Allowed Origins:
# - Use '*' to allow requests from any frontend origin (simplest for testing)
# - Or specify comma-separated frontend URLs, e.g.:
#   ALLOWED_ORIGINS=https://my-shopease-store.netlify.app,https://my-shopease-store.vercel.app
ALLOWED_ORIGINS=*
